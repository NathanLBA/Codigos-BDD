CREATE VIEW vw_cliente_pr AS  
SELECT ID, NOME_COMPLETO, CIDADE
FROM CLIENTE
WHERE ESTADO = 'PR';

SELECT * FROM vw_cliente_pr;

CREATE OR REPLACE VIEW vw_pedido_cliente AS
SELECT
    c.nome_completo AS nome_cliente,  
    p.valor AS valor_pedido,
    p.data_pedido AS data_pedido      
FROM pedido p
JOIN cliente c ON p.cliente_id = c.id;

SELECT * FROM vw_pedido_cliente;

CREATE VIEW VW_VALOR_ESTOQUE AS
SELECT NOME, PRECO, ESTOQUE, (PRECO*ESTOQUE) AS VALOR_TOTAL
FROM PRODUTO;

SELECT * FROM VW_VALOR_ESTOQUE;

CREATE VIEW vw_total_cliente AS
SELECT
    c.nome_completo AS nome_cliente,
    COUNT(p.id) AS quantidade_pedidos,
    SUM(p.valor) AS valor_total_gasto
FROM cliente c
JOIN pedido p ON p.cliente_id = c.id
GROUP BY c.id, c.nome_completo;

SELECT * FROM vw_total_cliente;

CREATE VIEW vw_desempenho_vendedores AS
SELECT
    v.nome_completo AS nome_vendedor,
    COUNT(vd.id) AS quantidade_venda,
    SUM(vd.valor) AS valor_total_vendido,
    AVG(vd.valor) AS valor_medio_venda,
    MAX(vd.valor) AS maior_venda
FROM VENDEDOR v
JOIN VENDA vd ON vd.vendedor_id = v.id
GROUP BY v.id, v.nome_completo;

SELECT * FROM vw_desempenho_vendedores;
