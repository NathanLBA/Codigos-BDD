
CREATE TABLE contas (
    id INT PRIMARY KEY AUTO_INCREMENT,
    titular VARCHAR(100),
    saldo DECIMAL(10,2)
);

INSERT INTO contas (titular, saldo)
VALUES
('João', 2000.00),
('Ana', 700.00);


START TRANSACTION;


SET saldo = saldo - 300
WHERE id = 1;

UPDATE contas
SET saldo = saldo + 300
WHERE id = 2;


SELECT * FROM contas;

COMMIT;

SELECT * FROM contas;

START TRANSACTION;

UPDATE contas
SET saldo = saldo - 200
WHERE id = 2;

UPDATE contas
SET saldo = saldo + 200
WHERE id = 1;

SELECT * FROM contas;

ROLLBACK;

SELECT * FROM contas;


